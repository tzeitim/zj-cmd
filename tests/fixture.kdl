keybinds {
    shared_except "locked" "tmux" {
        unbind "Ctrl g" "Ctrl t"
    }
    tmux clear-defaults=true {
        // Exit tmux mode
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Up" "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "?" { Run "zj-keybinds" { floating true; close_on_exit true; }; SwitchToMode "Normal"; }
    }
}
